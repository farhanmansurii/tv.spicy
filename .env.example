# Copy to .env.local (gitignored) and fill in the values.
# Nothing here is a real credential. Empty values are placeholders.

# ── Site URL ──────────────────────────────────────────────────────────────────
# Canonical origin used for metadata, the sitemap and auth base URL fallback.
# Optional: falls back to https://spicy-tv.vercel.app
NEXT_PUBLIC_SITE_URL=

# ── TMDB credentials ─────────────────────────────────────────────────────────
# Required in production: exactly one of the bearer token or API key pair must be set.
# The NEXT_PUBLIC_ prefixed names are bundled into the browser, so they are visible
# to users. Treat them as public-but-rate-limited credentials.
NEXT_PUBLIC_TMDB_BEARER_TOKEN=
NEXT_PUBLIC_TMDB_API_KEY=
# Server-only alternatives with the same meaning; either name works.
TMDB_BEARER_TOKEN=
TMDB_API_KEY=

# ── Database ──────────────────────────────────────────────────────────────────
# Postgres connection string. Required in production.
DATABASE_URL=
# Prisma Accelerate URL. Optional: when set it takes precedence over DATABASE_URL.
PRISMA_DATABASE_URL=

# ── Authentication ────────────────────────────────────────────────────────────
# Signs sessions and cookies. Required in production: lib/auth logs an error if
# neither BETTER_AUTH_SECRET nor NEXTAUTH_SECRET is set.
BETTER_AUTH_SECRET=
NEXTAUTH_SECRET=
# Public origin of the deployment used as the auth base URL. Required in production
# if the deployment is not on Vercel (otherwise VERCEL_URL is used).
BETTER_AUTH_URL=
NEXTAUTH_URL=
# Client side auth base URL. Optional: falls back to the current origin.
NEXT_PUBLIC_BETTER_AUTH_URL=

# ── Google sign-in ────────────────────────────────────────────────────────────
# Optional feature, but lib/auth logs an error in production while they are unset.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# ── Email (magic links) ───────────────────────────────────────────────────────
# Optional: without RESEND_API_KEY magic links are printed to the server log.
# The `resend` package is not in package.json, so the console fallback runs today.
RESEND_API_KEY=
EMAIL_FROM=

# ── Injected by the platform, never set these manually ────────────────────────
# VERCEL_URL       set by Vercel, used as the auth base URL fallback
# NODE_ENV         set by Next.js, controls production console stripping and auth checks
